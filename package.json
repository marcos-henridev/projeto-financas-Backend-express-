{
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "formater": "prettier . --write",
    "format:check": "prettier --check .",
    "debug": "DEBUG=router:* npx tsx src/server.ts ",
    "debugTransaction": "DEBUG=app:router:transactions npx tsx src/modules/transactions/transactions.controller.ts",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "ci": "npm run format:check &&npm run prisma:validate && npm run prisma:generate && npm run typecheck"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prettier": "3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
